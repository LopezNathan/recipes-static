---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CookMode from '../../components/CookMode.tsx';
import { formatMinutes } from '../../lib/time';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { data } = recipe;
const { Content } = await render(recipe);
const total = data.time.prep + data.time.cook;
---

<Base title={data.title} description={`${data.title} — ${data.servings} servings`}>
  <article>
    <h1>{data.title}</h1>

    <div class="recipe-meta">
      <span>Prep {formatMinutes(data.time.prep)}</span>
      <span>Cook {formatMinutes(data.time.cook)}</span>
      <span>Total {formatMinutes(total)}</span>
      {data.rating && <span>{'★'.repeat(data.rating)}</span>}
    </div>

    {
      data.tags.length > 0 && (
        <div class="tags">
          {data.tags.map((tag) => (
            <a class="tag" href={`/tags/${tag}/`}>
              {tag}
            </a>
          ))}
        </div>
      )
    }

    {data.source && (
      <p class="muted">Source: <a href={data.source} rel="noopener">{data.source}</a></p>
    )}

    <div class="notes">
      <Content />
    </div>

    <CookMode
      client:visible
      baseServings={data.servings}
      ingredients={data.ingredients}
      steps={data.steps}
    />

    <p class="muted recipe-edit-link">
      <a
        href={`https://github.com/LopezNathan/recipes-static/edit/main/src/content/recipes/${recipe.id}.md`}
        rel="noopener"
        target="_blank"
      >
        Edit this recipe on GitHub
      </a>
    </p>
  </article>
</Base>
